<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Urna.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:DataType="vm:ResultadoViewModel"
        x:Class="Urna.UI.Views.ResultadoView">
        <StackPanel Classes="Body">
                <Button Content="Votar Novamente"
                        Command="{Binding ResultadoBotaoCommand}"
                        CommandParameter="Novamente"/>
                <Button Content="Finalizar Votação"
                        Command="{Binding ResultadoBotaoCommand}"
                        CommandParameter="Finalizar"/>
        </StackPanel>
</UserControl>
